<Window x:Class="QLKS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lí khách sạn - Nhóm 10"
        Height="760"
        Width="1250"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F3F5F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2F3F92">
            <StackPanel Margin="18">
                <TextBlock Text="Luxury Hotel"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,20,0,35"/>

                <Button Content="Đăng nhập"
                        Height="42"
                        Margin="0,5"
                        Click="BtnLogin_Click"/>

                <Button Content="Nhân viên"
                        Height="42"
                        Margin="0,5"
                        Click="BtnStaff_Click"/>

                <Button Content="Đặt phòng / Check-in"
                        Height="42"
                        Margin="0,5"
                        Click="BtnBooking_Click"/>

                <Button Content="Hóa đơn / Check-out"
                        Height="42"
                        Margin="0,5"
                        Click="BtnInvoice_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                <DockPanel Margin="18,0">
                    <TextBlock Text=""
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ContentControl x:Name="MainContent"
                            Grid.Row="1"
                            Margin="18"/>
        </Grid>
    </Grid>
</Window>