<UserControl x:Class="QLKS.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QLKS.ViewModels"
             Background="#F4F6F9">

    <UserControl.DataContext>
        <vm:SearchViewModel/>
    </UserControl.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Search bar -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════
             ROW 0 — SEARCH BAR
        ════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                  Opacity="0.08" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search TextBox -->
                <Border Grid.Column="0"
                        Background="#F4F6F9"
                        CornerRadius="6"
                        Padding="10,0"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon kính lúp -->
                        <TextBlock Grid.Column="0"
                                   Text="🔍"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Foreground="#2C3E50">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <!-- Placeholder khi chưa nhập -->
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Tìm theo tên, số điện thoại..."
                                                                       Foreground="#AAAAAA"
                                                                       FontSize="14"
                                                                       Margin="2,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Nút Reset -->
                <Button Grid.Column="1"
                        Content="↺  Reset"
                        Height="36"
                        Padding="16,0"
                        FontSize="13"
                        Foreground="#555"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F4F6F9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <!-- Click reset: xóa SearchText → ExecuteSearch tự chạy lại -->
                    <Button.CommandParameter>
                        <x:Null/>
                    </Button.CommandParameter>
                    <!-- Dùng code-behind đơn giản cho Reset vì SearchViewModel chưa có ResetCommand -->
                    <i:Interaction.Triggers                xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
                        <i:EventTrigger EventName="Click">
                            <i:InvokeCommandAction
                                Command="{Binding DataContext.ResetCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             ROW 1 — DATA GRID
        ════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                  Opacity="0.08" Color="#000000"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding ListKhachHang}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      BorderThickness="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFBFC"
                      SelectionMode="Single"
                      CanUserResizeRows="False"
                      FontSize="13"
                      Foreground="#2C3E50"
                      Margin="0">

                <!-- Style header -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Setter Property="Foreground" Value="#6C757D"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,10"/>
                        <Setter Property="BorderBrush" Value="#EEEEEE"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Style row -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="44"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EBF3FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6E8FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <!-- ── Columns — đặt tên theo đúng property trong model KhachHang ── -->
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Họ tên"
                                        Binding="{Binding HoTen}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Số điện thoại"
                                        Binding="{Binding SDT}"
                                        Width="140"/>

                    <DataGridTextColumn Header="CCCD"
                                        Binding="{Binding CCCD}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Địa chỉ"
                                        Binding="{Binding DiaChi}"
                                        Width="200"/>

                    <!-- Cột thao tác: Sửa / Xóa -->
                    <DataGridTemplateColumn Header="Thao tác" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <!-- Nút Sửa -->
                                    <Button Content="✏"
                                            ToolTip="Chỉnh sửa"
                                            Width="30" Height="30"
                                            Margin="2,0"
                                            FontSize="14"
                                            Foreground="#1a73e8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"/>

                                    <!-- Nút Xóa -->
                                    <Button Content="🗑"
                                            ToolTip="Xóa"
                                            Width="30" Height="30"
                                            Margin="2,0"
                                            FontSize="14"
                                            Foreground="#E53935"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

                <!-- Empty state khi không có kết quả -->
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="0,60">
                                                <TextBlock Text="🔍"
                                                           FontSize="40"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Không tìm thấy kết quả"
                                                           FontSize="15"
                                                           Foreground="#AAAAAA"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>

            </DataGrid>
        </Border>
    </Grid>
</UserControl>
