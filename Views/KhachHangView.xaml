<UserControl x:Class="QLKS.Views.KhachHangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000"
             Background="#1E1E2E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ KHÁCH HÀNG" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#27293D" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Họ và Tên *" FontWeight="SemiBold" Foreground="#A9A9B8" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SelectedKhachHang.HoTen, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#1E1E2E" Foreground="White" BorderBrush="#2B3553" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,15"/>

                    <TextBlock Text="Số CCCD/Passport *" FontWeight="SemiBold" Foreground="#A9A9B8" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SelectedKhachHang.CCCD, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#1E1E2E" Foreground="White" BorderBrush="#2B3553" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,15"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="Số Điện Thoại *" FontWeight="SemiBold" Foreground="#A9A9B8" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SelectedKhachHang.SDT, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#1E1E2E" Foreground="White" BorderBrush="#2B3553" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Địa Chỉ" FontWeight="SemiBold" Foreground="#A9A9B8" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedKhachHang.DiaChi, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#1E1E2E" Foreground="White" BorderBrush="#2B3553" VerticalContentAlignment="Center" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#A9A9B8" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedKhachHang.Email, UpdateSourceTrigger=PropertyChanged}" Height="35" Background="#1E1E2E" Foreground="White" BorderBrush="#2B3553" VerticalContentAlignment="Center" Padding="5"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="120">
                    <Button Content="Thêm mới" Command="{Binding AddCommand}" Background="#E14ECA" Foreground="White" Height="35" Margin="0,0,0,10" BorderThickness="0"/>
                    <Button Content="Cập nhật" Command="{Binding UpdateCommand}" Background="#4D83FF" Foreground="White" Height="35" Margin="0,0,0,10" BorderThickness="0"/>
                    <Button Content="Xóa" Command="{Binding DeleteCommand}" Background="#FF5353" Foreground="White" Height="35" Margin="0,0,0,10" BorderThickness="0"/>
                    <Button Content="Làm mới" Command="{Binding ClearCommand}" Background="#3D405B" Foreground="White" Height="35" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#27293D" CornerRadius="8" Padding="10">
            <DataGrid ItemsSource="{Binding DanhSachKhachHang}" 
                      SelectedItem="{Binding SelectedKhachHang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      Background="#27293D" Foreground="White" RowBackground="#27293D" BorderThickness="0" RowHeight="35" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2B3553">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E1E2E"/>
                        <Setter Property="Foreground" Value="#A9A9B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3D405B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã KH" Binding="{Binding MaKH}" Width="80"/>
                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding HoTen}" Width="*"/>
                    <DataGridTextColumn Header="Số CCCD" Binding="{Binding CCCD}" Width="150"/>
                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding SDT}" Width="150"/>
                    <DataGridTextColumn Header="Địa Chỉ" Binding="{Binding DiaChi}" Width="150"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>