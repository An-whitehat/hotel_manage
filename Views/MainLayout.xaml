<Window x:Class="QLKS.Views.MainLayout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QLKS.ViewModels"
        xmlns:views="clr-namespace:QLKS.Views"
        xmlns:local="clr-namespace:QLKS"
        mc:Ignorable="d"
        Title="Happy Hotel" Height="680" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">
    <Window.DataContext>
        <vm:MainLayoutViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Ánh xạ các ViewModel sang View tương ứng -->
        <DataTemplate DataType="{x:Type vm:StaffViewModel}">
            <local:StaffView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookingViewModel}">
            <views:BookingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FloorPlanViewModel}">
            <views:FloorPlanViewUC/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoiceCheckoutViewModel}">
            <local:InvoiceCheckoutView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BaoCaoViewModel}">
            <views:BaoCaoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RoomViewModel}">
            <views:RoomView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:CustomerViewModel}">
            <views:CustomerView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:RevenueViewModel}">
            <views:RevenueView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PrintMainViewModel}">
            <views:PrintMainView/>
        </DataTemplate>

        <!-- Style nút sidebar -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="24,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <Grid>
                                <!-- Active indicator -->
                                <Rectangle x:Name="indicator"
                                           Width="4"
                                           HorizontalAlignment="Left"
                                           Fill="Transparent"
                                           RadiusX="2" RadiusY="2"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D4059"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A6EBD"/>
                                <Setter TargetName="indicator" Property="Fill" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════ SIDEBAR ═══════ -->
        <Border Grid.Column="0" Background="#1E2A3A">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top"
                        Background="#162030"
                        Height="64">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="🏨  Happy Hotel"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Hệ thống quản lý"
                                   Foreground="#7F8C8D"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Divider -->
                <Rectangle DockPanel.Dock="Top"
                           Height="1"
                           Fill="#2D3E50"
                           Margin="16,0"/>

                <!-- Menu label -->
                <TextBlock DockPanel.Dock="Top"
                           Text="MENU CHÍNH"
                           Foreground="#4A5568"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="24,16,0,8"
                           />
                <Border DockPanel.Dock="Bottom"
                        Background="#162030"
                        Height="56"
                        Padding="16,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUser, StringFormat='👤  {0}'}"
                     Foreground="White"
                     FontSize="13"/>
                        <TextBlock Text="{Binding VaiTro}"
                     Foreground="#7F8C8D"
                     FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Nav buttons -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" BorderThickness="0">
                    <StackPanel>
                        <Button Content="📊  Trang chủ"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Dashboard"/>
                        <Button Content="🛏  Quản lý phòng"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="Room"/>
                        <Button Content="🗺  Sơ đồ phòng"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="FloorPlan"/>
                        <Button Content="📅  Đặt phòng"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Booking"/>
                        <Button Content="👤  Tìm kiếm"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Search"/>
                        <Button Content="🧾  Hóa đơn"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Invoice"/>
                        <Button Content="👨‍💼  Nhân viên"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Staff"/>
                        <Button Content="👤  Khách hàng"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Customer"/>
                        <Button Content="📈  Thống kê doanh thu"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="MyRevenueStats"/>
                        <Button Content="📋  Báo cáo"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="MyPrintMenu"/>
                    </StackPanel>
                </ScrollViewer>
                <!-- Bottom: user info -->
              
            </DockPanel>
        </Border>

        <!-- ═══════ MAIN CONTENT ═══════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <TextBlock Text="{Binding CurrentPageTitle}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dd/MM/yyyy'}"
                               HorizontalAlignment="Right"
                               Foreground="#718096"
                               FontSize="13"
                               VerticalAlignment="Center"
                               xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
                </Grid>
            </Border>

            <!-- Content area -->
            <Border Grid.Row="1" Padding="20">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
