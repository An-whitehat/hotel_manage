<Window x:Class="QLKS.Views.MainLayout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLKS.Views"
        mc:Ignorable="d"
        Title="MainLayout" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="162*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="201*"/>
            <ColumnDefinition Width="599*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Grid.RowSpan="3"/>
        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="Happy Hotel" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1">
            <Button Content="Trang chủ" Height="36"/>
            <Button Content="Quản lý phòng" Height="36"/>
            <Button Content="Sơ đồ phòng" Height="36"/>
            <Button Content="Đặt phòng" Height="37"/>
            <Button Content="Khách hàng" Height="36"/>
            <Button Content="Hóa đơn" Height="36"/>
            <Button Content="Thống kê doanh thu" Height="36"/>
            <Button Content="Báo cáo" Height="36"/>
            <Button Content="Nhân viên" Height="36"/>
        </StackPanel>

    </Grid>
</Window>
