<UserControl x:Class="QLKS.InvoiceCheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#2F3F92" CornerRadius="12" Padding="18" Margin="0,0,0,12">
            <TextBlock Text="Hóa đơn thanh toán + Check-out" Foreground="White" FontSize="24" FontWeight="Bold"/>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="Tạo hóa đơn check-out" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="Phiếu đang check-in"/>
                    <ComboBox ItemsSource="{Binding ActiveBookings}" SelectedItem="{Binding SelectedBooking}" DisplayMemberPath="Display" Margin="0,3,0,8"/>
                    <TextBlock Text="Tiền dịch vụ"/><TextBox Text="{Binding TienDichVu, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
                    <TextBlock Text="Phụ thu"/><TextBox Text="{Binding PhuThu, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
                    <TextBlock Text="Ghi chú"/><TextBox Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
                    <TextBlock Text="Tổng tiền" FontWeight="Bold"/><TextBox Text="{Binding TongTien, StringFormat=N0}" IsReadOnly="True" FontSize="18" FontWeight="Bold" Margin="0,3,0,12"/>
                    <WrapPanel>
                        <Button Content="Tính tiền" Command="{Binding CalculateCommand}" Margin="3" Padding="14,7"/>
                        <Button Content="Tạo hóa đơn + Check-out" Command="{Binding CreateCheckoutInvoiceCommand}" Margin="3" Padding="14,7"/>
                    </WrapPanel>
                    <TextBlock Text="Công thức: số đêm × giá phòng + dịch vụ + phụ thu." Foreground="#666" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Tải lại" Command="{Binding LoadCommand}" Width="90" Height="32" Margin="0,0,8,0"/>
                        <Button Content="Đánh dấu đã thanh toán" Command="{Binding MarkPaidCommand}" Width="170" Margin="0,0,8,0"/>
                        <Button Content="In hóa đơn" Command="{Binding PrintInvoiceCommand}" Width="110"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding HoaDons}" SelectedItem="{Binding SelectedHoaDon}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã HĐ" Binding="{Binding MaHoaDon}" Width="70"/>
                            <DataGridTextColumn Header="Mã ĐP" Binding="{Binding MaDatPhong}" Width="70"/>
                            <DataGridTextColumn Header="Khách" Binding="{Binding TenKhachHang}" Width="150"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding SoPhong}" Width="70"/>
                            <DataGridTextColumn Header="Ngày lập" Binding="{Binding NgayLap, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, StringFormat=N0}" Width="110"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiText}" Width="120"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding TenNhanVien}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
