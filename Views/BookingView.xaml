<UserControl x:Class="QLKS.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#2F3F92" CornerRadius="12" Padding="18" Margin="0,0,0,12">
            <TextBlock Text="Đặt phòng + Check-in" Foreground="White" FontSize="24" FontWeight="Bold"/>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="Thông tin đặt phòng" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="Mã đặt phòng"/><TextBox Text="{Binding MaDatPhong}" IsReadOnly="True" Margin="0,3,0,8"/>
                    <TextBlock Text="Khách hàng"/><ComboBox ItemsSource="{Binding KhachHangs}" SelectedItem="{Binding SelectedKhachHang}" DisplayMemberPath="Display" Margin="0,3,0,8"/>
                    <TextBlock Text="Phòng trống"/><ComboBox ItemsSource="{Binding PhongsTrong}" SelectedItem="{Binding SelectedPhong}" DisplayMemberPath="Display" Margin="0,3,0,8"/>
                    <TextBlock Text="Ngày check-in"/><DatePicker SelectedDate="{Binding NgayCheckIn}" Margin="0,3,0,8"/>
                    <TextBlock Text="Ngày check-out"/><DatePicker SelectedDate="{Binding NgayCheckOut}" Margin="0,3,0,8"/>
                    <TextBlock Text="Số người"/><TextBox Text="{Binding SoNguoi, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
                    <TextBlock Text="Ghi chú"/><TextBox Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,12"/>
                    <WrapPanel>
                        <Button Content="Tạo phiếu" Command="{Binding AddBookingCommand}" Margin="3" Padding="14,7"/>
                        <Button Content="Sửa" Command="{Binding UpdateBookingCommand}" Margin="3" Padding="14,7"/>
                        <Button Content="Check-in" Command="{Binding CheckInCommand}" Margin="3" Padding="14,7"/>
                        <Button Content="Hủy" Command="{Binding CancelBookingCommand}" Margin="3" Padding="14,7"/>
                        <Button Content="Mới" Command="{Binding ClearCommand}" Margin="3" Padding="14,7"/>
                    </WrapPanel>
                </StackPanel></ScrollViewer>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="280" Height="32" Margin="0,0,8,0"/>
                        <Button Content="Tìm" Command="{Binding SearchCommand}" Width="80"/>
                        <Button Content="Tải lại" Command="{Binding LoadCommand}" Width="80" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding DatPhongs}" SelectedItem="{Binding SelectedDatPhong}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaDatPhong}" Width="60"/>
                            <DataGridTextColumn Header="Khách" Binding="{Binding TenKhachHang}" Width="160"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding SoPhong}" Width="80"/>
                            <DataGridTextColumn Header="Check-in" Binding="{Binding NgayCheckIn, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Check-out" Binding="{Binding NgayCheckOut, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Số người" Binding="{Binding SoNguoi}" Width="80"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding TenNhanVien}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
